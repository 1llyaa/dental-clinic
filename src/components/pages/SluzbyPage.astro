---
import Base from '../../layouts/Base.astro';
import FinalCta from '../FinalCta.astro';
import { getTranslations, type Locale } from '../../i18n/utils';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import implantatyImg from '../../images/implantaty.jpg';
import prfCentrifugaImg from '../../images/prf-centrifuga.jpg';
import estetikaImg from '../../images/estetika.jpg';
import hygienaImg from '../../images/hygiena.jpg';
import rajskyPlyn2Img from '../../images/rajsky-plyn-2.jpg';
import zachovnaImg from '../../images/zachovna.jpg';
import chirurgieImg from '../../images/chirurgie.jpg';
import beleniImg from '../../images/beleni.jpg';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = getTranslations(locale);
const s = t.sluzby;
const svcPhotos: (ImageMetadata | null)[] = [
  implantatyImg,
  prfCentrifugaImg,
  estetikaImg,
  hygienaImg,
  rajskyPlyn2Img,
  zachovnaImg,
  chirurgieImg,
  beleniImg,
  null,
];
---
<Base title={s.meta.title} description={s.meta.description} locale={locale}>

  <section class="page-header">
    <div class="wrap">
      <h1>{s.header.h1}</h1>
      <p>{s.header.sub}</p>
    </div>
  </section>

  <div class="anchor-nav">
    <div class="anchor-nav-inner">
      {s.anchors.map(a => (
        <a href={`#${a.id}`} class:list={[{ priority: a.priority }]}>{a.text}</a>
      ))}
    </div>
  </div>

  {s.services.map((svc, i) => (
    <section class="svc-block" id={svc.id}>
      <div class="wrap">
        <div class="svc-block-inner fade-in">
          <div class="svc-block-text">
            <h2>{svc.title}</h2>
            {'paragraphs' in svc && (svc as any).paragraphs.map((p: string) => <p>{p}</p>)}
            {'intro' in svc && (
              <>
                <p>{(svc as any).intro}</p>
                <p><strong>{(svc as any).listHeading}</strong></p>
                <ul class="svc-list">
                  {(svc as any).list.map((item: string) => <li>{item}</li>)}
                </ul>
                <p set:html={`<strong>Další oblasti využití:</strong> ${(svc as any).additionalUse.replace('Další oblasti využití: ', '')}`} />
                <div class="svc-safety">
                  <p set:html={`<strong>Bezpečnost:</strong> ${(svc as any).safety.replace('Bezpečnost: ', '')}`} />
                </div>
              </>
            )}
            {'note' in svc && <div class="svc-note">{(svc as any).note}</div>}
            <a href={t.site.phoneLink} class="svc-cta">{svc.cta}</a>
          </div>
          <div class="svc-block-photo">
            {svcPhotos[i] ? <Image src={svcPhotos[i]!} alt={svc.photoAlt} loading="lazy" /> : svc.photoAlt}
          </div>
        </div>
      </div>
    </section>
  ))}

  <FinalCta locale={locale} label={s.cta.label} title={s.cta.title} sub={s.cta.sub} hours={s.cta.hours} />

</Base>

<script>
const fadeObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) { entry.target.classList.add('visible'); fadeObserver.unobserve(entry.target); }
  });
}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
document.querySelectorAll('.fade-in').forEach(el => fadeObserver.observe(el));

const sections = document.querySelectorAll('.svc-block');
const anchors  = document.querySelectorAll('.anchor-nav a');
let scrollingFromClick = false;
let lockTimer: ReturnType<typeof setTimeout> | null = null;

function setActive(el: Element) {
  anchors.forEach(x => x.classList.remove('active'));
  el.classList.add('active');
  (el as HTMLElement).scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
}

anchors.forEach(a => {
  a.addEventListener('click', () => {
    setActive(a);
    scrollingFromClick = true;
    if (lockTimer) clearTimeout(lockTimer);
    if ('onscrollend' in window) {
      window.addEventListener('scrollend', () => { scrollingFromClick = false; }, { once: true });
      lockTimer = setTimeout(() => { scrollingFromClick = false; }, 3000);
    } else {
      lockTimer = setTimeout(() => { scrollingFromClick = false; }, 3000);
    }
  });
});

const anchorObserver = new IntersectionObserver((entries) => {
  if (scrollingFromClick) return;
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      const active = document.querySelector(`.anchor-nav a[href="#${entry.target.id}"]`);
      if (active) setActive(active);
    }
  });
}, { threshold: 0.2, rootMargin: '-140px 0px -60% 0px' });
sections.forEach(s => anchorObserver.observe(s));
</script>
