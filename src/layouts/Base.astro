---
import '../styles/global.css';
import Topbar from '../components/Topbar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  locale?: Locale;
}

const { title, description, ogTitle, locale = 'cs' } = Astro.props;
const currentYear = new Date().getFullYear();
const ogLocaleMap: Record<Locale, string> = { cs: 'cs_CZ', en: 'en_US', de: 'de_DE', it: 'it_IT' };
---
<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={ogLocaleMap[locale]} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <Topbar locale={locale} />
  <Nav locale={locale} />
  <slot />
  <Footer locale={locale} currentYear={currentYear} />
</body>
</html>
