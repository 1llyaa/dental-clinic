---
import { getTranslations, type Locale } from '../i18n/utils';

interface Props {
  currentYear: number;
  locale?: Locale;
}
const { currentYear, locale = 'cs' } = Astro.props;
const t = getTranslations(locale);
const prefix = locale === 'cs' ? '' : `/${locale}`;
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-inner">
      <div>
        <div class="footer-brand">{t.footer.brand}</div>
        <div class="footer-legal-id">
          {t.footer.legal1}<br />
          {t.footer.legal2}<br />
          {t.footer.legal3}
        </div>
      </div>
      <div class="footer-links">
        <a href={`${prefix}/sluzby`}>{t.nav.services}</a>
        <a href={`${prefix}/o-nas`}>{t.nav.about}</a>
        <a href={`${prefix}/kontakt`}>{t.nav.contact}</a>
      </div>
      <div class="footer-bottom">
        © {currentYear} DENTIYAK s.r.o.<br />
        <a href={`${prefix}/ochrana-osobnich-udaju`}>{t.footer.gdpr}</a>
      </div>
    </div>
  </div>
</footer>
