---
import { getTranslations, type Locale } from '../i18n/utils';
import LangSwitch from './LangSwitch.astro';

interface Props { locale?: Locale; }
const { locale = 'cs' } = Astro.props;
const t = getTranslations(locale);
const prefix = locale === 'cs' ? '' : `/${locale}`;
const pathname = Astro.url.pathname;
const isActive = (path: string) => pathname === path || pathname.startsWith(path + '/');
---
<nav class="nav">
  <div class="nav-inner">
    <a href={prefix || '/'} class="nav-logo">{t.nav.logo}</a>
    <div class="nav-toggle" id="nav-toggle" aria-label="Menu" role="button" tabindex="0">
      <span></span><span></span><span></span>
    </div>
    <div class="nav-links" id="nav-links">
      <a href={`${prefix}/sluzby`} class:list={[{ active: isActive(`${prefix}/sluzby`) }]}>{t.nav.services}</a>
      <a href={`${prefix}/o-nas`}  class:list={[{ active: isActive(`${prefix}/o-nas`) }]}>{t.nav.about}</a>
      <a href={`${prefix}/kontakt`} class:list={[{ active: isActive(`${prefix}/kontakt`) }]}>{t.nav.contact}</a>
    </div>
    <div class="nav-actions">
      <LangSwitch locale={locale} class="nav-lang" />
      <a href={t.site.phoneLink} class="nav-phone">{t.site.phone}</a>
    </div>
  </div>
</nav>

<div class="nav-overlay" id="nav-overlay" aria-hidden="true">
  <nav class="nav-overlay-links">
    <a href={`${prefix}/sluzby`} class:list={[{ active: isActive(`${prefix}/sluzby`) }]}>{t.nav.services}</a>
    <a href={`${prefix}/o-nas`}  class:list={[{ active: isActive(`${prefix}/o-nas`) }]}>{t.nav.about}</a>
    <a href={`${prefix}/kontakt`} class:list={[{ active: isActive(`${prefix}/kontakt`) }]}>{t.nav.contact}</a>
  </nav>
  <LangSwitch locale={locale} class="nav-overlay-lang" />
  <div class="nav-overlay-contact">
    <a href={t.site.phoneLink} class="nav-overlay-phone">{t.site.phone}</a>
    <span class="nav-overlay-address">{t.footer.legal2}</span>
  </div>
</div>

<script>
const toggle  = document.getElementById('nav-toggle');
const overlay = document.getElementById('nav-overlay');

function openMenu() {
  overlay?.classList.add('open');
  toggle?.classList.add('open');
  overlay?.setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
}
function closeMenu() {
  overlay?.classList.remove('open');
  toggle?.classList.remove('open');
  overlay?.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
}

toggle?.addEventListener('click', () => overlay?.classList.contains('open') ? closeMenu() : openMenu());
toggle?.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' || e.key === ' ') overlay?.classList.contains('open') ? closeMenu() : openMenu();
});
overlay?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
</script>
